{
  "name": "packer-plugin-dev",
  "image": "leoarry/devcontainer-hashicorp-plugin:latest",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/root/.claude,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "hashicorp.hcl",
        "github.vscode-github-actions",
        "anthropic.claude-code"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.useLanguageServer": true
      }
    }
  },
  "remoteEnv": {
    "PACKER_PLUGIN_PATH": "/root/.config/packer/plugins"
  }
}