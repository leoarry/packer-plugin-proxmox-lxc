{
  "name": "packer-plugin-dev",
  "image": "leoarry/packer-plugin-devcontainer:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "hashicorp.hcl",
        "github.vscode-github-actions"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.useLanguageServer": true
      }
    }
  },
  "remoteEnv": {
    "PACKER_PLUGIN_PATH": "/root/.config/packer/plugins",
    "ANTHROPIC_AUTH_TOKEN": "${localEnv:OPENROUTER_APIKEY}"
  }
}