{
  "name": "packer-plugin-dev",
  "image": "leoarry/hashicorp-plugin-devcontainer:latest",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh-host,type=bind,readonly,consistency=cached"
  ],
  "postCreateCommand": "mkdir -p /root/.ssh && cp -r /root/.ssh-host/. /root/.ssh/ && chmod -R go-rwx /root/.ssh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "hashicorp.hcl",
        "github.vscode-github-actions",
        "anthropic.claude-code"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.useLanguageServer": true
      }
    }
  },
  "remoteEnv": {
    "PACKER_PLUGIN_PATH": "/root/.config/packer/plugins"
  }
}